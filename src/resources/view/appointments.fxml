<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hairsalon.controller.AppointmentController"
      style="-fx-background-color: #F5ECD7;"
      VBox.vgrow="ALWAYS">
    <!-- ── FORM PANEL ─────────────────────────── -->
    <VBox style="-fx-background-color: #FFFDF8; -fx-min-width: 288; -fx-pref-width: 288; -fx-border-color: transparent #E0C9A8 transparent transparent; -fx-border-width: 0 1 0 0;">
        <VBox style="-fx-background-color: #1C0F09; -fx-padding: 20 22;" spacing="4">
            <Label text="New Appointment"
                   style="-fx-text-fill: #F5ECD7; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label text="Fill in the details below"
                   style="-fx-text-fill: #C8975A; -fx-font-size: 11px;"/>
        </VBox>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: #FFFDF8; -fx-border-color: transparent;">
            <VBox spacing="10" style="-fx-padding: 20 16; -fx-background-color: #FFFDF8;">
                <Label text="CLIENT NAME" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <TextField fx:id="clientNameField" promptText="Enter client name"/>
                <Label text="SERVICE" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="serviceBox" prefWidth="254" maxWidth="1.7976931348623157E308"/>
                <Label text="STYLIST" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="stylistBox" prefWidth="254" maxWidth="1.7976931348623157E308"/>
                <Label text="DATE" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <DatePicker fx:id="datePicker" prefWidth="254" maxWidth="1.7976931348623157E308"/>
                <Label text="TIME" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <TextField fx:id="timeField" promptText="e.g.  14:30"/>
                <Label text="STATUS" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="statusBox" prefWidth="254" maxWidth="1.7976931348623157E308"/>
                <Region prefHeight="8"/>
                <Button fx:id="submitBtn" text="Add Appointment" styleClass="btn-brown"
                        maxWidth="1.7976931348623157E308" onAction="#addAppointment"/>
                <Button text="Clear Form" styleClass="btn-cream"
                        maxWidth="1.7976931348623157E308" onAction="#clearForm"/>
                <!-- Delete button: brown border, cream bg, dark brown text -->
                <Button fx:id="deleteBtn" text="Delete Selected"
                        disable="true"
                        maxWidth="1.7976931348623157E308" onAction="#deleteAppointment"
                        style="-fx-background-color: #F5ECD7; -fx-text-fill: #2C1810; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 10 22; -fx-cursor: hand; -fx-border-color: #6B3A2A; -fx-border-width: 1; -fx-border-radius: 8; -fx-opacity: 0.5;"/>
            </VBox>
        </ScrollPane>
    </VBox>
    <!-- ── TABLE SIDE ─────────────────────────── -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #F5ECD7;">
        <HBox style="-fx-background-color: #FFFDF8; -fx-padding: 18 24 15 24; -fx-border-color: transparent transparent #E0C9A8 transparent; -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT">
            <VBox spacing="3">
                <Label text="Appointments" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1C0F09;"/>
                <Label text="Click a row to edit  ·  All scheduled and past appointments"
                       style="-fx-font-size: 12px; -fx-text-fill: #6B3A2A;"/>
            </VBox>
        </HBox>
        <VBox style="-fx-padding: 18;" VBox.vgrow="ALWAYS">
            <TableView fx:id="appointmentTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn"      text="ID"      prefWidth="55"/>
                    <TableColumn fx:id="clientColumn"  text="Client"  prefWidth="155"/>
                    <TableColumn fx:id="serviceColumn" text="Service" prefWidth="140"/>
                    <TableColumn fx:id="stylistColumn" text="Stylist" prefWidth="140"/>
                    <TableColumn fx:id="dateColumn"    text="Date"    prefWidth="108"/>
                    <TableColumn fx:id="timeColumn"    text="Time"    prefWidth="78"/>
                    <TableColumn fx:id="statusColumn"  text="Status"  prefWidth="108"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>
</HBox>
