<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hairsalon.controller.AppointmentController"
      style="-fx-background-color: #F5ECD7;"
      VBox.vgrow="ALWAYS">
    <!-- ── FORM PANEL ─────────────────────────── -->
    <VBox style="-fx-background-color: #FFFDF8; -fx-min-width: 288; -fx-pref-width: 288; -fx-border-color: transparent #E0C9A8 transparent transparent; -fx-border-width: 0 1 0 0;">
        <VBox style="-fx-background-color: #1C0F09; -fx-padding: 20 22;" spacing="4">
            <Label text="New Appointment"
                   style="-fx-text-fill: #F5ECD7; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label text="Fill in the details below"
                   style="-fx-text-fill: #C8975A; -fx-font-size: 11px;"/>
        </VBox>
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color: transparent; -fx-background: #FFFDF8; -fx-border-color: transparent;">
            <VBox spacing="10" style="-fx-padding: 20 16; -fx-background-color: #FFFDF8;">
                <Label text="CLIENT NAME" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <TextField fx:id="clientNameField" promptText="Enter client name"/>
                <Label text="SERVICE" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <ComboBox fx:id="serviceBox" prefWidth="254" maxWidth="1.7976931348623157E308"/>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
