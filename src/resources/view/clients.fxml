<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.hairsalon.controller.ClientController"
      style="-fx-background-color: #F5ECD7;"
      VBox.vgrow="ALWAYS">

    <!-- ── FORM PANEL ─────────────────────────── -->
    <VBox style="-fx-background-color: #FFFDF8; -fx-min-width: 288; -fx-pref-width: 288; -fx-border-color: transparent #E0C9A8 transparent transparent; -fx-border-width: 0 1 0 0;">

        <VBox style="-fx-background-color: #1C0F09; -fx-padding: 20 22;" spacing="4">
            <Label text="Add / Edit Client"
                   style="-fx-text-fill: #F5ECD7; -fx-font-size: 15px; -fx-font-weight: bold;"/>
            <Label text="Client information"
                   style="-fx-text-fill: #C8975A; -fx-font-size: 11px;"/>
        </VBox>

        <VBox spacing="10" style="-fx-padding: 20 16; -fx-background-color: #FFFDF8;">

            <Label text="FULL NAME" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <TextField fx:id="nameField" promptText="Enter full name"/>

            <Label text="PHONE" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <TextField fx:id="phoneField" promptText="+383 44 000 000"/>

            <Label text="EMAIL" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
            <TextField fx:id="emailField" promptText="client@email.com"/>

            <VBox style="-fx-background-color: #F5ECD7; -fx-background-radius: 10; -fx-padding: 14 12; -fx-border-color: #E0C9A8; -fx-border-radius: 10; -fx-border-width: 1;" spacing="10">
                <Label text="GENDER" style="-fx-text-fill: #6B3A2A; -fx-font-size: 11px; -fx-font-weight: bold;"/>
                <HBox spacing="20">
                    <RadioButton fx:id="femaleRadio" text="Female"/>
                    <RadioButton fx:id="maleRadio"   text="Male"/>
                </HBox>
                <Separator/>
                <CheckBox fx:id="vipCheckBox" text="⭐  Mark as VIP"
                          style="-fx-text-fill: #2C1810; -fx-font-weight: bold;"/>
            </VBox>

            <Region prefHeight="6"/>

            <Button fx:id="submitBtn" text="Save Client" styleClass="btn-brown"
                    maxWidth="1.7976931348623157E308" onAction="#addClient"/>
            <Button text="Clear Form" styleClass="btn-cream"
                    maxWidth="1.7976931348623157E308" onAction="#clearForm"/>
            <Button fx:id="deleteBtn" text="Delete Selected"
                    disable="true"
                    maxWidth="1.7976931348623157E308" onAction="#deleteClient"
                    style="-fx-background-color: #F5ECD7; -fx-text-fill: #2C1810; -fx-font-weight: bold; -fx-font-size: 13px; -fx-background-radius: 8; -fx-padding: 10 22; -fx-cursor: hand; -fx-border-color: #6B3A2A; -fx-border-width: 1; -fx-border-radius: 8; -fx-opacity: 0.5;"/>

        </VBox>
    </VBox>

    <!-- ── TABLE SIDE ─────────────────────────── -->
    <VBox HBox.hgrow="ALWAYS" style="-fx-background-color: #F5ECD7;">

        <HBox style="-fx-background-color: #FFFDF8; -fx-padding: 18 24 15 24; -fx-border-color: transparent transparent #E0C9A8 transparent; -fx-border-width: 0 0 1 0;" alignment="CENTER_LEFT">
            <VBox spacing="3">
                <Label text="Clients" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #1C0F09;"/>
                <Label text="Click a row to edit  ·  Your complete client directory"
                       style="-fx-font-size: 12px; -fx-text-fill: #6B3A2A;"/>
            </VBox>
        </HBox>

        <VBox style="-fx-padding: 18;" VBox.vgrow="ALWAYS">
            <TableView fx:id="clientTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="idColumn"    text="ID"    prefWidth="65"/>
                    <TableColumn fx:id="nameColumn"  text="Name"  prefWidth="210"/>
                    <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="180"/>
                    <TableColumn fx:id="emailColumn" text="Email" prefWidth="260"/>
                </columns>
            </TableView>
        </VBox>
    </VBox>

</HBox>
